;; Shared review cases as data (ADR 0001 §4).
;; Each case: {:id ... :fn <core fn name> :args [...] :expect {...}}.
;; Positive and negative controls are paired; the runner fails closed
;; on any mismatch.
[{:id "target-ok"
  :fn "valid-target?"
  :args [{:target/name "otehon-shell"
          :target/origin "https://example.invalid/shell/"
          :target/kinds #{:shell}
          :target/artifact-digest "sha256:0123456789abcdef"}]
  :expect {:ok true
           :target {:target/name "otehon-shell"
                    :target/origin "https://example.invalid/shell/"
                    :target/kinds #{:shell}
                    :target/artifact-digest "sha256:0123456789abcdef"}}}

 {:id "target-rejects-http-origin"
  :fn "valid-target?"
  :args [{:target/name "otehon-shell"
          :target/origin "http://example.invalid/shell/"
          :target/kinds #{:shell}
          :target/artifact-digest "sha256:0123456789abcdef"}]
  :expect {:ok false :reasons [:origin-must-be-https]}}

 {:id "target-rejects-blank-name"
  :fn "valid-target?"
  :args [{:target/name "  "
          :target/origin "https://example.invalid/shell/"
          :target/kinds #{:shell}
          :target/artifact-digest "sha256:0123456789abcdef"}]
  :expect {:ok false :reasons [:blank-name]}}

 {:id "target-rejects-unknown-kind"
  :fn "valid-target?"
  :args [{:target/name "wallet-probe"
          :target/origin "https://example.invalid/w/"
          :target/kinds #{:wallet}
          :target/artifact-digest "sha256:0123456789abcdef"}]
  :expect {:ok false :reasons [:unknown-or-empty-kinds]}}

 {:id "target-rejects-missing-digest"
  :fn "valid-target?"
  :args [{:target/name "saifu-screen"
          :target/origin "https://example.invalid/saifu/"
          :target/kinds #{:dapp}}]
  :expect {:ok false :reasons [:missing-artifact-digest]}}

 {:id "matrix-2x2x1"
  :fn "matrix"
  :args [{:browsers ["chromium" "firefox"]
          :devices ["desktop" "pixel-8"]
          :viewports ["1280x800"]}]
  :expect {:ok true
           :sessions [{:browser "chromium" :device "desktop" :viewport "1280x800"}
                      {:browser "chromium" :device "pixel-8" :viewport "1280x800"}
                      {:browser "firefox" :device "desktop" :viewport "1280x800"}
                      {:browser "firefox" :device "pixel-8" :viewport "1280x800"}]}}

 {:id "matrix-rejects-empty-axis"
  :fn "matrix"
  :args [{:browsers [] :devices ["desktop"] :viewports ["1280x800"]}]
  :expect {:ok false :reasons [:no-browsers]}}

 {:id "matrix-over-cap-is-error"
  :fn "matrix"
  :args [{:browsers ["a" "b" "c"] :devices ["d1" "d2"] :viewports ["v"]} 4]
  :expect {:ok false :reasons [:matrix-over-cap] :count 6 :cap 4}}

 {:id "verdict-all-pass"
  :fn "verdict"
  :args [[{:step "s1" :status :pass} {:step "s2" :status :pass}]]
  :expect {:status :pass :evidence-count 2}}

 {:id "verdict-fail-dominates-blocked"
  :fn "verdict"
  :args [[{:step "s1" :status :blocked}
          {:step "s2" :status :fail}
          {:step "s3" :status :pass}]]
  :expect {:status :fail :failed ["s2"] :evidence-count 3}}

 {:id "verdict-blocked-without-fail"
  :fn "verdict"
  :args [[{:step "s1" :status :blocked} {:step "s2" :status :pass}]]
  :expect {:status :blocked :blocked ["s1"] :evidence-count 2}}

 {:id "verdict-unknown-status-fail-closed"
  :fn "verdict"
  :args [[{:step "s1" :status :pass} {:step "s2" :status :skipped}]]
  :expect {:status :fail :reasons [:unknown-step-status] :offenders ["s2"]}}

 {:id "strip-secrets-nested"
  :fn "strip-secrets"
  :args [{:target {:name "shell" :username "u" :password "p"}
          :session {:token "t" :id "s-1"}
          :verdict {:status :pass}}]
  :expect {:target {:name "shell"}
           :session {:id "s-1"}
           :verdict {:status :pass}}}

 ;; --- agent loop policy (ADR 0002) ---

 {:id "loop-accepts-navigation"
  :fn "plan-step"
  :args [{:steps [] :snapshots 0}
         {:type :navigate :params {:url "https://example.invalid/shell/"}}]
  :expect {:ok true
           :action {:type :navigate
                    :params {:url "https://example.invalid/shell/"}}}}

 {:id "loop-rejects-forbidden-action"
  :fn "plan-step"
  :args [{:steps [] :snapshots 0}
         {:type :click-submit :params {}}]
  :expect {:ok false :reasons [:forbidden-action]}}

 {:id "loop-rejects-credential-params"
  :fn "plan-step"
  :args [{:steps [] :snapshots 0}
         {:type :navigate
          :params {:url "https://example.invalid/" :token "t" }}]
  :expect {:ok false :reasons [:credential-params-refused]}}

 {:id "loop-rejects-http-navigation"
  :fn "plan-step"
  :args [{:steps [] :snapshots 0}
         {:type :navigate :params {:url "http://example.invalid/"}}]
  :expect {:ok false :reasons [:non-https-navigation-refused]}}

 {:id "loop-rejects-over-budget"
  :fn "plan-step"
  :args [{:steps [{} {}] :snapshots 0 :budget {:max-steps 2 :max-snapshots 1}}
         {:type :snapshot :params {}}]
  :expect {:ok false :reasons [:budget-exhausted]}}

 {:id "loop-stops-on-fail"
  :fn "loop-reduce"
  :args [{:steps [] :snapshots 0 :status :running}
         {:action {:type :assert-text :params {:text "OK"}}
          :outcome {:step-status :fail}}]
  :expect {:steps [{:action {:type :assert-text :params {:text "OK"}}
                    :outcome {:step-status :fail}}]
           :snapshots 0
           :status :stopped
           :stop-reason :step-failed}}

 {:id "loop-marks-done"
  :fn "loop-reduce"
  :args [{:steps [] :snapshots 0 :status :running}
         {:action {:type :snapshot :params {}}
          :outcome {:step-status :pass :done true}}]
  :expect {:steps [{:action {:type :snapshot :params {}}
                    :outcome {:step-status :pass :done true}}]
           :snapshots 1
           :status :done}}

 {:id "loop-unknown-outcome-fail-closed"
  :fn "loop-reduce"
  :args [{:steps [] :snapshots 0 :status :running}
         {:action {:type :snapshot :params {}}
          :outcome {:step-status :guessed}}]
  :expect {:steps [{:action {:type :snapshot :params {}}
                    :outcome {:step-status :guessed}}]
           :snapshots 0
           :status :stopped
           :stop-reason :unknown-outcome}}

 {:id "loop-summarize-strips-secrets"
  :fn "summarize"
  :args [{:steps [{:action {:type :navigate
                            :params {:url "https://example.invalid/"
                                     :token "t"}}
                   :outcome {:step-status :pass}}]
           :snapshots 0
           :status :done}]
  :expect {:loop-status :done
           :stop-reason nil
           :verdict {:status :pass :evidence-count 1}
           :receipt {:steps [{:action {:type :navigate
                                       :params {:url "https://example.invalid/"}}
                              :outcome {:step-status :pass}}]
                     :verdict {:status :pass :evidence-count 1}}}}]
